{
  "name": "raaz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "node -e \"process.env.RAAZ_URL ??= 'http://127.0.0.1:5173'; require('child_process').execSync('npx vitest run e2e/two-phones', {stdio:'inherit', env: process.env})\"",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "icons": "node scripts/icons.mjs",
    "ship": "node scripts/deploy.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "keys": "node scripts/keys.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "idb": "^8.0.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "workerd@1.20261119.1": true
